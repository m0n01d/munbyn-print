*PPD-Adobe:             "4.3"
*%
*% Munbyn RW403B (native) -- munbyn-print project.
*% Derived from Munbyn's /Library/Printers/Munbyn/RW403B.ppd (FileVersion 1.0.4,
*% created by Caissa 2024/08/13). Same options, defaults and 203 dpi 8-bit gray
*% raster, but the filter is munbyn-print's native (arm64 + x86_64)
*% rastertotspl, which emits only the TSPL subset verified on the printer.
*% Added: 4x4/4x3/4x2/4x1 in sizes, a 1-4.25 x 0.5-20 in custom size, and
*% a Threshold option. Installed by scripts/install-cups-queue.sh.
*%
*FormatVersion:         "4.3"
*FileVersion:           "1.0.0"
*LanguageVersion:       English
*LanguageEncoding:      ISOLatin1
*PCFileName:            "RW403BN.ppd"
*Manufacturer:          "Munbyn"
*Product:               "(RW403B)"
*ModelName:             "Munbyn RW403B native"
*NickName:              "Munbyn RW403B (native)"
*ShortNickName:         "Munbyn RW403B (native)"
*1284DeviceID:          "MFG:Munbyn;CMD:XPP,XL;MDL:RW403B;CLS:PRINTER"
*cupsVersion:           1.2
*cupsManualCopies:      False
*cupsFilter:            "application/vnd.cups-raster 0 /Library/Printers/Munbyn/rastertotspl"
*PSVersion:             "(3010.000) 550"
*PSVersion:             "(3010.000) 651"
*PSVersion:             "(3010.000) 652"
*PSVersion:             "(3010.000) 653"
*PSVersion:             "(3010.000) 704"
*PSVersion:             "(3010.000) 705"
*PSVersion:             "(3010.000) 800"
*LanguageLevel:         "3"
*ColorDevice:           False
*DefaultColorSpace:     Gray
*FileSystem:            False
*Throughput:            "1"
*LandscapeOrientation:  Plus90
*VariablePaperSize:     True
*TTRasterizer:          Type42


*MaxMediaWidth:         "306.14"
*MaxMediaHeight:        "1440"
*HWMargins:             0.00 0.00 0.00 0.00
*CustomPageSize True:   "pop pop pop <</PageSize[5 -2 roll]/ImagingBBox null>>setpagedevice"
*ParamCustomPageSize    Width:          1 points 72 306.14
*ParamCustomPageSize    Height:         2 points 36 1440
*ParamCustomPageSize    WidthOffset:    3 points 0 0
*ParamCustomPageSize    HeightOffset:   4 points 0 0
*ParamCustomPageSize    Orientation:    5 int 0 0
*RequiresPageRegion     All:            True

