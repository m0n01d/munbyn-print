# Native CUPS filter for the Munbyn RW403B: CUPS raster -> verified TSPL subset.
#
#   make              build ./rastertotspl (universal: arm64 + x86_64)
#   make OUT=/x/y     build to another path (the tests do this)
#   make test-local   build, then run tests/test_cups_filter.py (no printer,
#                     no install; uses cupsfilter when available)
#   make ppd FEED_SCALE=0.981 PPD_OUT=/x/y.ppd
#                     write the PPD to install: the template with its default
#                     Resolution set to 203 x round(203 / FEED_SCALE) dpi
#   make clean
#
# Installing is scripts/install-cups-queue.sh (run with sudo by a human).

ifeq ($(origin CC),default)
CC = clang
endif
SDK     ?= $(shell xcrun --show-sdk-path 2>/dev/null)
ARCHS   ?= -arch arm64 -arch x86_64
MINOS   ?= -mmacosx-version-min=12.0
CFLAGS  ?= -O2 -g
WARN     = -Wall -Wextra -Wno-deprecated-declarations
SYSROOT  = $(if $(SDK),-isysroot $(SDK))
LIBS     = -lcups -lcupsimage -lm
OUT     ?= rastertotspl

# Feed scale = printed length / intended length along the paper feed.
# 0.981: an 800-row bar printed 98.1 mm on the RW403B (caliper, 2026-09-27).
FEED_SCALE   ?= 0.981
PPD_TEMPLATE  = munbyn-rw403b-native.ppd
PPD_OUT      ?=

.PHONY: all clean test-local ppd

all: $(OUT)

$(OUT): rastertotspl.c Makefile
	$(CC) $(ARCHS) $(MINOS) $(SYSROOT) $(CFLAGS) $(WARN) -o $@ rastertotspl.c $(LIBS)

test-local: $(OUT)
	cd .. && .venv/bin/pytest -q --timeout=300 tests/test_cups_filter.py

# The template's default choice is 203x207dpi (feed scale 0.981). This
# rewrites that one choice (keyword, label, HWResolution) for FEED_SCALE and
# drops the uncorrected 203x203dpi choice if the two would collide. It fails
# unless exactly one default line and one choice line were rewritten.
ppd:
	@test -n '$(PPD_OUT)' || { echo 'usage: make ppd FEED_SCALE=0.981 PPD_OUT=/path/to/out.ppd' >&2; exit 1; }
	@f='$(FEED_SCALE)'; out='$(PPD_OUT)'; \
	case "$$f" in ''|*[!0-9.]*|*.*.*) echo "error: FEED_SCALE must be a decimal like 0.981 (got '$$f')" >&2; exit 1 ;; esac; \
	y=$$(awk -v f="$$f" 'BEGIN { if (f + 0 < 0.9 || f + 0 > 1.1) exit 1; printf "%d", int(203 / f + 0.5) }') \
	  || { echo "error: FEED_SCALE $$f is outside 0.90..1.10" >&2; exit 1; }; \
	awk -v y="$$y" -v f="$$f" ' \
	  /^\*FormatVersion:/ { print "*% Generated by make -C cups ppd: FEED_SCALE=" f " -> default Resolution 203x" y "dpi."; print "*%" } \
	  /^\*Resolution 203x203dpi\// && y == 203 { next } \
	  /^\*DefaultResolution: 203x207dpi$$/ { print "*DefaultResolution: 203x" y "dpi"; nd++; next } \
	  /^\*Resolution 203x207dpi\// { \
	    n = sub(/^\*Resolution 203x207dpi\/[^:]*:/, "*Resolution 203x" y "dpi/203 dpi, feed-corrected (" f "):"); \
	    n += sub(/HWResolution\[203 207\]/, "HWResolution[203 " y "]"); \
	    if (n == 2) nr++; print; next } \
	  { print } \
	  END { if (nd != 1 || nr != 1) exit 3 }' $(PPD_TEMPLATE) > "$$out.tmp" \
	  || { rm -f "$$out.tmp"; echo "error: $(PPD_TEMPLATE) has no single 203x207dpi Resolution choice to rewrite" >&2; exit 1; }; \
	mv -f "$$out.tmp" "$$out"; \
	echo "$$out: feed scale $$f -> Resolution 203x$${y}dpi (HWResolution [203 $$y])"

clean:
	rm -rf $(OUT) $(OUT).dSYM
